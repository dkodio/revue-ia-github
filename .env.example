# Copier en .env et renseigner les jetons. Ne jamais versionner .env.
OPENPROJECT_URL=http://localhost:8080
OPENPROJECT_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
# Jeton à permissions fines limité au dépôt choisi.
GITHUB_TOKEN=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=300
# Valeur locale generee par scripts/init_env.py
OPENPROJECT_SECRET_KEY_BASE=
# Tags de demonstration flottants. Figer les digests apres validation.
OPENPROJECT_IMAGE=openproject/openproject:17
OLLAMA_IMAGE=ollama/ollama:latest
